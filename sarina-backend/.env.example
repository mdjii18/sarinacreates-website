# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file (it's already in .gitignore).

# MongoDB Atlas connection string (free tier is enough for this shop).
# Get it from: https://www.mongodb.com/cloud/atlas -> Connect -> Drivers
# It looks like: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Password for the hidden admin panel. If left unset, defaults to sarina2026 —
# change it here before your first deploy, or from Settings after logging in.
ADMIN_PASSWORD=sarina2026
